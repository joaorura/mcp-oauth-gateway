# ============================================================================
# mcp-oauth-gateway — configuracao
#
# Copie este arquivo para .env e preencha os valores reais:
#   cp .env.example .env        (Linux/macOS)
#   Copy-Item .env.example .env (Windows/PowerShell)
#
# NUNCA versione o .env — o .gitignore ja bloqueia, mas confira sempre com
# `git status` antes do primeiro commit.
# ============================================================================


# --- Backend: o servidor MCP que este gateway protege -----------------------
#
# BACKEND_TRANSPORT escolhe COMO o gateway fala com o backend: "http" ou "stdio".
# Esta e a UNICA parte deste projeto que muda dependendo de qual MCP voce
# esta protegendo, e ela muda por configuracao — nao por edicao de codigo.

BACKEND_TRANSPORT=http

# Usado somente se BACKEND_TRANSPORT=http.
# A URL do endpoint MCP do backend (geralmente termina em /mcp).
BACKEND_URL=http://127.0.0.1:3000/mcp

# Usado somente se BACKEND_TRANSPORT=http. OPCIONAL — deixe vazio se o
# backend nao exigir autenticacao (ex.: um servidor local protegido so por
# estar em 127.0.0.1). Se preenchido, o gateway envia
# "Authorization: Bearer <valor>" em toda chamada ao backend.
BACKEND_BEARER_TOKEN=

# Usado somente se BACKEND_TRANSPORT=stdio.
# O executavel a rodar — o gateway spawna esse processo e fala stdio com ele
# diretamente. Nao ha bearer nem HTTP envolvidos neste modo.
BACKEND_COMMAND=npx

# Usado somente se BACKEND_TRANSPORT=stdio.
# Argumentos do comando, como uma linha de shell (aceita aspas para caminhos
# com espaco). Exemplo real, servindo um vault Obsidian via enquire-mcp:
#   BACKEND_ARGS=-y @oomkapwn/enquire-mcp serve --vault "C:\caminho com espaco"
BACKEND_ARGS=

# OPCIONAL — so relevante para BACKEND_TRANSPORT=http quando voce quer que o
# script de boot (scripts/start-gateway.ps1) suba o backend automaticamente
# junto com o gateway, em vez de voce gerencia-lo separadamente. Deixe as
# duas vazias se o backend ja roda em outro lugar, ou se for stdio (nesse
# caso o proprio gateway ja cuida de subir o processo).
BACKEND_START_COMMAND=
BACKEND_START_ARGS=


# --- Google OAuth -------------------------------------------------------
#
# Criados no Google Cloud Console. Veja o README, secao
# "Criando o OAuth Client no Google", para o passo a passo completo.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# A URL PUBLICA e ESTAVEL pela qual clientes MCP alcancam este gateway
# (via Tailscale Funnel, Cloudflare Tunnel, um dominio proprio, etc).
# SEM barra no final. O redirect URI registrado no Google Cloud Console DEVE
# ser exatamente esta URL + "/auth/callback".
PUBLIC_BASE_URL=https://seu-host.exemplo.com


# --- Allowlist ---------------------------------------------------------
#
# Quem pode usar este gateway, depois de autenticar com o Google. Lista de
# e-mails separada por virgula. Allowlist ausente ou vazia = ninguem passa
# (o gateway falha fechado por padrao, nunca aberto).

ALLOWED_EMAILS=voce@gmail.com


# --- Gateway (opcionais — ja tem um default razoavel) -----------------------

GATEWAY_NAME=MCP OAuth Gateway
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000

# OPCIONAL — texto livre entregue ao cliente MCP no `initialize`, antes de
# qualquer ferramenta ser chamada (campo `instructions` do protocolo MCP).
# E o lugar certo para descrever o PROPOSITO do backend ("para que serve
# este vault/API"), e tambem para dar instrucoes de comportamento ao
# assistente -- por exemplo, pedir que ele confirme a identidade de quem
# esta conversando antes de usar as ferramentas, quando o backend e de uso
# restrito a uma pessoa mas o conector pode estar acessivel a mais gente
# numa mesma conversa/workspace. Isso e uma camada de UX/orientacao, nao
# de seguranca tecnica -- a allowlist (ALLOWED_EMAILS) e o unico perimetro
# que de fato bloqueia acesso. Vazio = nenhuma instrucao extra.
GATEWAY_INSTRUCTIONS=

# Onde o access.log (log de auditoria, com rotacao por tamanho) e os logs de
# processo por execucao sao gravados.
LOG_DIR=./logs
